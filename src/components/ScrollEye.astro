---
---
<div id="scroll-eye-container" class="fixed bottom-6 right-6 z-50 transition-transform duration-300 transform translate-y-20 opacity-0 hidden md:flex flex-col items-center gap-2 pointer-events-none" aria-hidden="true">
  <div class="caption-mono text-[var(--color-link)] text-[10px] tracking-widest bg-[var(--color-canvas)] px-2 py-0.5 rounded border border-[var(--color-link)] opacity-80 uppercase" id="scroll-progress-text">0%</div>
  
  <div class="relative w-12 h-12 bg-[var(--color-canvas)] rounded-full border-2 border-[var(--color-hairline-strong)] shadow-lg flex items-center justify-center overflow-hidden">
    <!-- Eyelids (tech aesthetic) -->
    <div class="absolute inset-0 border-[3px] border-[var(--color-ink)] rounded-full clip-eye pointer-events-none"></div>
    
    <!-- The Pupil -->
    <div id="scroll-pupil" class="w-5 h-5 bg-[var(--color-link)] rounded-full relative transition-transform duration-75 ease-out shadow-[0_0_10px_var(--color-link)]">
      <div class="absolute top-1 right-1 w-1.5 h-1.5 bg-white rounded-full opacity-80"></div>
    </div>
  </div>
</div>

<style>
  .clip-eye {
    clip-path: polygon(0 40%, 50% 10%, 100% 40%, 100% 60%, 50% 90%, 0 60%);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('scroll-eye-container');
    const pupil = document.getElementById('scroll-pupil');
    const text = document.getElementById('scroll-progress-text');
    
    if (!container || !pupil || !text) return;

    // Show eye only after scrolling down a bit
    const handleScroll = () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      
      if (docHeight <= 0) return;

      const progress = Math.min(1, Math.max(0, scrollY / docHeight));
      
      // Update text
      text.textContent = Math.round(progress * 100) + '% READ';

      // Move pupil vertically: -10px (top) to +10px (bottom)
      const pupilY = -10 + (progress * 20);
      pupil.style.transform = `translateY(${pupilY}px)`;

      // Show/hide container
      if (scrollY > 200) {
        container.classList.remove('translate-y-20', 'opacity-0');
      } else {
        container.classList.add('translate-y-20', 'opacity-0');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Init
  });
</script>
