---
const modes = [
  {
    id: 'screen',
    label: 'Screen',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="3" width="12" height="8" rx="1"/><line x1="5" y1="14" x2="11" y2="14"/><line x1="8" y1="11" x2="8" y2="14"/></svg>`,
  },
  {
    id: 'gyroscope',
    label: 'Gyroscope',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="4" y="1" width="8" height="14" rx="2"/><circle cx="8" cy="12" r="1" fill="currentColor"/></svg>`,
  },
  {
    id: 'camera',
    label: 'Camera',
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 5a1 1 0 011-1h2l1-2h4l1 2h2a1 1 0 011 1v7a1 1 0 01-1 1H3a1 1 0 01-1-1V5z"/><circle cx="8" cy="8.5" r="2.5"/></svg>`,
  },
];
---

<div class="flex items-center justify-center flex-wrap" style="gap: var(--spacing-xs);" id="mode-switcher" role="tablist" aria-label="Protractor measurement mode">
  {modes.map((mode) => (
    <button
      role="tab"
      aria-selected={mode.id === 'screen' ? 'true' : 'false'}
      aria-controls={`panel-${mode.id}`}
      id={`tab-${mode.id}`}
      data-mode={mode.id}
      class:list={[
        'flex items-center body-sm cursor-pointer border-none transition-all duration-150',
        mode.id === 'screen'
          ? 'bg-[var(--color-ink)] text-[var(--color-on-primary)]'
          : 'bg-[var(--color-canvas)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-canvas-soft-2)]',
      ]}
      style="padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-pill-sm); gap: var(--spacing-xs);"
      type="button"
    >
      <span set:html={mode.icon} />
      {mode.label}
    </button>
  ))}
</div>
