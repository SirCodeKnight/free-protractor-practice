---
---
<div class="relative w-full h-[600px] lg:h-[800px] bg-[#111] rounded-2xl overflow-hidden border border-[#333] shadow-2xl group">
  <!-- Pendulum Floating Code Box -->
  <div class="absolute top-8 right-8 z-10 pendulum-swing pointer-events-none">
    <div class="bg-[#222] border border-[#444] rounded-lg p-3 shadow-[0_10px_30px_rgba(0,0,0,0.5)]">
      <!-- "String" of the pendulum -->
      <div class="absolute -top-8 left-1/2 w-0.5 h-8 bg-[#555] -translate-x-1/2"></div>
      <!-- Code Content -->
      <div class="flex items-center gap-2 mb-2">
        <div class="w-2.5 h-2.5 rounded-full bg-red-500"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-yellow-500"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-green-500"></div>
      </div>
      <pre class="font-mono text-xs text-[#aaddff]"><code><span class="text-pink-500">const</span> graph = <span class="text-blue-400">new</span> ForceGraph();
graph.<span class="text-yellow-300">init</span>(nodes);</code></pre>
    </div>
  </div>

  <!-- The Canvas Container -->
  <div id="knowledge-graph" class="w-full h-full cursor-grab active:cursor-grabbing"></div>
  
  <!-- Overlay text -->
  <div class="absolute bottom-4 left-4 text-xs font-mono text-[#555] pointer-events-none select-none">
    OBSIDIAN_ENGINE v1.0.4 // SCROLL TO ZOOM // DRAG NODES // CLICK TO NAVIGATE
  </div>
</div>

<script>
  import ForceGraph from 'force-graph';

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('knowledge-graph');
    if (!container) return;

    // Define the graph data
    const gData = {
      nodes: [
        { id: 'hub', name: 'Knowledge Hub', val: 30, color: '#ff0080', url: '/blog' },
        
        // Geometry/Math Cluster
        { id: 'geo', name: 'Geometry Core', val: 20, color: '#7928ca' },
        { id: 'tricks', name: '5 Geometry Tricks', val: 10, color: '#fff', url: '/blog/5-life-saving-geometry-tricks' },
        { id: 'ratio', name: 'Golden Ratio', val: 10, color: '#fff', url: '/blog/golden-ratio-modern-design' },
        
        // Tools/Printables Cluster
        { id: 'tools', name: 'Digital Tools', val: 20, color: '#007cf0' },
        { id: 'plastic', name: 'Digital vs Plastic', val: 10, color: '#fff', url: '/blog/digital-protractors-replacing-plastic' },
        { id: 'print', name: 'Print Perfect Protractor', val: 10, color: '#fff', url: '/blog/how-to-print-perfect-protractor' },
        
        // Engineering Cluster
        { id: 'eng', name: 'Engineering', val: 20, color: '#f9cb28' },
        { id: 'blueprints', name: 'Complex Blueprints', val: 10, color: '#fff', url: '/blog/measuring-complex-angles-blueprints' }
      ],
      links: [
        { source: 'hub', target: 'geo' },
        { source: 'hub', target: 'tools' },
        { source: 'hub', target: 'eng' },
        
        { source: 'geo', target: 'tricks' },
        { source: 'geo', target: 'ratio' },
        
        { source: 'tools', target: 'plastic' },
        { source: 'tools', target: 'print' },
        
        { source: 'eng', target: 'blueprints' },
        
        // Cross-connections for cool web effect
        { source: 'blueprints', target: 'plastic' },
        { source: 'ratio', target: 'blueprints' }
      ]
    };

    // Initialize ForceGraph
    const Graph = ForceGraph()(container)
      .graphData(gData)
      .backgroundColor('#111111')
      .nodeRelSize(4)
      .nodeLabel('name')
      .nodeColor('color')
      .linkColor(() => '#333333')
      .linkWidth(1.5)
      .onNodeClick(node => {
        if (node.url) {
          window.location.href = node.url;
        }
      });

    // Make nodes glow
    Graph.nodeCanvasObject((node, ctx, globalScale) => {
      const label = node.name;
      const fontSize = 12/globalScale;
      ctx.font = `${fontSize}px Inter, sans-serif`;
      const textWidth = ctx.measureText(label).width;
      const bckgDimensions = [textWidth, fontSize].map(n => n + fontSize * 0.2); // some padding

      // Draw node circle
      ctx.beginPath();
      ctx.arc(node.x, node.y, Math.sqrt(node.val || 10), 0, 2 * Math.PI, false);
      ctx.fillStyle = node.color;
      ctx.fill();
      
      // Draw glow
      ctx.shadowColor = node.color;
      ctx.shadowBlur = 15;
      ctx.fill();
      ctx.shadowBlur = 0; // reset

      // Draw text
      if (node.id !== 'hub' && node.id !== 'geo' && node.id !== 'tools' && node.id !== 'eng') {
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
        ctx.fillText(label, node.x, node.y + Math.sqrt(node.val || 10) + fontSize);
      }
    });
    
    // Fit to container size
    const resizeObserver = new ResizeObserver(entries => {
      for (let entry of entries) {
        Graph.width(entry.contentRect.width);
        Graph.height(entry.contentRect.height);
      }
    });
    resizeObserver.observe(container);
  });
</script>
