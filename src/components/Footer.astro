---
const footerColumns = [
  {
    label: 'Tool',
    links: [
      { href: '/#protractor-tool', text: 'Screen Protractor' },
      { href: '/#protractor-tool', text: 'Gyroscope Mode' },
      { href: '/#protractor-tool', text: 'Camera Mode' },
      { href: '/#faq', text: 'FAQ' },
    ],
  },
  {
    label: 'Resources',
    links: [
      { href: '/blog', text: 'Blog' },
      { href: '/blog/how-to-measure-angles', text: 'How to Measure Angles' },
      { href: '/blog/protractor-vs-digital', text: 'Physical vs Digital' },
    ],
  },
  {
    label: 'Legal',
    links: [
      { href: '/privacy', text: 'Privacy Policy' },
      { href: '/terms', text: 'Terms & Conditions' },
    ],
  },
  {
    label: 'Connect',
    links: [
      { href: '/about', text: 'About Us' },
      { href: '/contact', text: 'Contact' },
    ],
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-canvas)] border-t border-[var(--color-hairline)]" style="padding: var(--spacing-4xl) var(--spacing-lg);">
  <div class="mx-auto" style="max-width: 1400px;">
    <div class="grid grid-cols-2 md:grid-cols-4" style="gap: var(--spacing-xl);">
      {footerColumns.map((col) => (
        <div>
          <p class="caption-mono text-[var(--color-mute)] uppercase tracking-wider" style="margin-bottom: var(--spacing-md);">
            {col.label}
          </p>
          <ul class="list-none p-0 m-0 flex flex-col" style="gap: var(--spacing-xs);">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="body-sm text-[var(--color-body)] no-underline transition-colors duration-150 hover:text-[var(--color-ink)]"
                >
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-[var(--color-hairline)] flex flex-col sm:flex-row items-center justify-between" style="margin-top: var(--spacing-4xl); padding-top: var(--spacing-lg); gap: var(--spacing-md);">
      <div class="flex items-center gap-2">
        <svg width="20" height="20" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <path d="M14 2C7.373 2 2 7.373 2 14h24C26 7.373 20.627 2 14 2Z" fill="var(--color-ink)" />
          <circle cx="14" cy="14" r="3" fill="var(--color-link)" />
        </svg>
        <span class="caption text-[var(--color-mute)]">
          © {currentYear} Online Protractor Tool. All rights reserved.
        </span>
      </div>
      <span class="caption text-[var(--color-mute)]">
        Free online angle measurement tool.
      </span>
    </div>
  </div>
</footer>
