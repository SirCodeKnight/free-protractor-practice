---
import Layout from '../layouts/Layout.astro';
import ContentSection from '../components/ContentSection.astro';

const title = "Geometry Calculator - Area, Volume & Perimeter";
const description = "Free online geometry calculator. Calculate area, volume, and perimeter for all 2D and 3D shapes.";
---
<Layout title={title} description={description}>
  <ContentSection>
    <div class="max-w-3xl mx-auto text-center" style="margin-bottom: var(--spacing-xl);">
      <p class="caption-mono text-[var(--color-mute)]" style="margin-bottom: var(--spacing-xs);">COMING SOON</p>
      <h1 class="display-lg text-[var(--color-ink)]">Geometry Calculator</h1>
      <p class="body-lg text-[var(--color-body)] mt-4">
        We are building a complete geometry calculator to help you easily find the area, perimeter, surface area, and volume of any geometric shape.
      </p>
      <a href="/" class="btn-primary mt-8 inline-block no-underline">Return to Protractor</a>
    </div>
  </ContentSection>
</Layout>
