---
import Layout from '../../layouts/Layout.astro';
import ContentSection from '../../components/ContentSection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import StudyNote from '../../components/StudyNote.astro';

const title = "The Ultimate Guide to Measuring Complex Angles on Blueprints";
const description = "Stop guessing on your schematics. Here is the foolproof method for measuring multi-axis blueprint angles.";
const image = "/images/blog/blueprints.png";

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  image: `https://webprotractor.netlify.app${image}`,
  description: description,
  author: {
    '@type': 'Organization',
    name: 'Online Geometry Tools'
  }
};
---
<Layout title={title} description={description} schemas={[articleSchema]}>
  <ContentSection>
    <div class="w-full flex justify-center mb-8">
      <Breadcrumbs items={[
        { name: 'Blog', url: '/blog' },
        { name: 'Blueprint Angles', url: '/blog/measuring-complex-angles-blueprints' }
      ]} />
    </div>

    <article class="max-w-[900px] mx-auto">
      <header class="text-center mb-12">
        <div class="flex items-center justify-center gap-3 mb-6">
          <span class="caption-mono text-[var(--color-link)] uppercase tracking-wider text-sm">Engineering Notes</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-hairline-strong)]"></span>
          <span class="caption text-[var(--color-mute)]">Study Guide • Chapter 3</span>
        </div>
      </header>
      
      <StudyNote>
        <span class="study-sticker" style="top: -15px; right: 15px;">🏗️</span>
        
        <h1 style="margin-top: 0;">Mastering <span class="study-highlight">Blueprint Angles</span></h1>
        <p>A single degree of error can cost millions. Don't guess. <span class="study-underline">Measure perfectly.</span></p>

        <h2>Step 1: Digitize 🖱️</h2>
        <p>Never measure a physical printout! Paper warps and ink bleeds. Use the raw DWG/DXF file.</p>

        <div class="study-box">
          <span class="study-sticker" style="top: -20px; left: -15px;">🎯</span>
          <h3>Step 2: Digital Overlay</h3>
          <ol class="list-decimal pl-6">
            <li><strong>Lock Origin:</strong> Place center exactly on the vertex.</li>
            <li><strong>Align Baseline:</strong> Rotate 0° line to the structural base.</li>
            <li><strong>Read Output:</strong> Let the software tell you it's 33.72° (never eyeball hash marks).</li>
          </ol>
        </div>

        <div class="flex justify-center my-6">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#29bc9b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 5v30M5 20h30"/>
            <circle cx="20" cy="20" r="10" />
          </svg>
        </div>

        <h2>Step 3: Math Verification 🧮</h2>
        <p>Good engineers never trust just one method.</p>
        
        <div class="study-code">
          // Verify with Trigonometry:
          const rise = 4;
          const run = 12;
          const angle = Math.atan(rise / run) * (180 / Math.PI);
          
          console.log(angle); // 18.43 degrees
        </div>
        
        <p>If the <span class="study-highlight">digital overlay</span> and the <span class="study-highlight">Trig math</span> match, you are clear to build!</p>

      </StudyNote>
    </article>
  </ContentSection>
  <RelatedTools currentPath="/blog/measuring-complex-angles-blueprints" />
</Layout>
