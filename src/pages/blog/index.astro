---
import Layout from '../../layouts/Layout.astro';
import ContentSection from '../../components/ContentSection.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';

const title = 'Enterprise Blog – Geometry & Design';
const description = 'Expert insights on geometry, architectural blueprints, digital measurement tools, and modern design principles.';

const posts = [
  {
    title: '5 Life-Saving Geometry Tricks Every Architect Uses Daily',
    excerpt: 'Discover the hidden mathematical shortcuts professionals use to calculate impossible angles in seconds.',
    href: '/blog/5-life-saving-geometry-tricks',
    date: 'August 10, 2026',
    category: 'Architecture',
    image: '/images/blog/arch-tricks.png'
  },
  {
    title: 'Why Digital Protractors Are Replacing Plastic Math Tools',
    excerpt: 'The classroom is changing. Find out why the classic plastic protractor is facing extinction in the digital age.',
    href: '/blog/digital-protractors-replacing-plastic',
    date: 'August 5, 2026',
    category: 'Technology',
    image: '/images/blog/digital-vs-plastic.png'
  },
  {
    title: 'The Ultimate Guide to Measuring Complex Angles on Blueprints',
    excerpt: 'Stop guessing on your schematics. Here is the foolproof method for measuring multi-axis blueprint angles.',
    href: '/blog/measuring-complex-angles-blueprints',
    date: 'July 28, 2026',
    category: 'Engineering',
    image: '/images/blog/blueprints.png'
  },
  {
    title: 'How to Print a Perfectly Accurate Protractor at Home',
    excerpt: 'Printer scaling issues ruining your measurements? Learn the exact settings to print a mathematically perfect protractor.',
    href: '/blog/how-to-print-perfect-protractor',
    date: 'July 22, 2026',
    category: 'Resources',
    image: '/images/blog/printing-protractor.png'
  },
  {
    title: 'The Hidden Math: Unlocking the Golden Ratio in Modern Design',
    excerpt: 'Why do certain websites look inherently beautiful? The answer lies in a 2,000-year-old mathematical sequence.',
    href: '/blog/golden-ratio-modern-design',
    date: 'July 14, 2026',
    category: 'Web Design',
    image: '/images/blog/golden-ratio.png'
  }
];

const featured = posts[0];
const rest = posts.slice(1);
---

<Layout title={title} description={description}>
  <ContentSection variant="light">
    <div class="max-w-[1600px] mx-auto w-full">
      
      <!-- Blog Header -->
      <div class="mb-12 text-center">
        <p class="caption-mono text-[var(--color-link)] mb-2 tracking-widest uppercase">Inside the Numbers</p>
        <h1 class="display-xl text-[var(--color-ink)] mb-4">The Geometry & Design Blog</h1>
        <p class="body-lg text-[var(--color-body)] max-w-[600px] mx-auto">
          Explore our interactive knowledge graph or browse the latest insights below.
        </p>
      </div>

      <!-- 2-Column Layout -->
      <div class="grid grid-cols-1 xl:grid-cols-[1fr_1.5fr] gap-12">
        
        <!-- Left Column: Sticky Knowledge Graph -->
        <div class="relative">
          <div class="xl:sticky xl:top-24">
            <h3 class="display-md text-[var(--color-ink)] mb-6 border-b border-[var(--color-hairline)] pb-4 flex items-center justify-between">
              Interactive Map
              <span class="text-xs px-2 py-1 bg-[#111] text-white rounded-md font-mono tracking-wider shadow-sm">OBSIDIAN_VIEW</span>
            </h3>
            <KnowledgeGraph />
          </div>
        </div>

        <!-- Right Column: Articles Grid -->
        <div class="flex flex-col gap-12">
          
          <!-- Hero Featured Post -->
          <div>
            <h3 class="display-md text-[var(--color-ink)] mb-6 border-b border-[var(--color-hairline)] pb-4">Featured</h3>
            <a href={featured.href} class="group block no-underline rounded-2xl overflow-hidden bg-[var(--color-canvas)] border border-[var(--color-hairline)] hover:border-[var(--color-link)] transition-all shadow-sm hover:shadow-lg">
              <div class="relative h-[300px] lg:h-[400px] overflow-hidden">
                <img src={featured.image} alt={featured.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
              <div class="p-8 lg:p-10 flex flex-col justify-center">
                <div class="flex items-center gap-3 mb-4">
                  <span class="caption-mono text-[var(--color-link)] uppercase tracking-wider">{featured.category}</span>
                  <span class="w-1 h-1 rounded-full bg-[var(--color-hairline-strong)]"></span>
                  <span class="caption text-[var(--color-mute)]">{featured.date}</span>
                </div>
                <h2 class="display-lg text-[var(--color-ink)] mb-4 group-hover:text-[var(--color-link)] transition-colors">{featured.title}</h2>
                <p class="body-lg text-[var(--color-body)] mb-8">{featured.excerpt}</p>
                <span class="btn-primary inline-flex items-center gap-2 self-start">
                  Read Note
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>
          </div>

          <!-- Latest Articles Grid -->
          <div>
            <h3 class="display-md text-[var(--color-ink)] mb-6 border-b border-[var(--color-hairline)] pb-4">Latest Notes</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {rest.map((post) => (
                <a href={post.href} class="group flex flex-col no-underline bg-[var(--color-canvas)] rounded-xl border border-[var(--color-hairline)] hover:border-[var(--color-link)] transition-all overflow-hidden h-full shadow-sm hover:shadow-md">
                  <div class="relative h-[200px] overflow-hidden">
                    <img src={post.image} alt={post.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                  </div>
                  <div class="p-6 flex flex-col flex-grow">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="caption-mono text-[var(--color-link)] uppercase tracking-wider text-xs">{post.category}</span>
                      <span class="w-1 h-1 rounded-full bg-[var(--color-hairline-strong)]"></span>
                      <span class="caption text-[var(--color-mute)] text-xs">{post.date}</span>
                    </div>
                    <h2 class="text-xl font-bold text-[var(--color-ink)] mb-3 group-hover:text-[var(--color-link)] transition-colors leading-tight">{post.title}</h2>
                    <p class="body-sm text-[var(--color-body)] mb-6 flex-grow">{post.excerpt}</p>
                    <span class="text-[var(--color-link)] font-medium inline-flex items-center gap-1 group-hover:underline text-sm">
                      Open Note &rarr;
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>

        </div>
      </div>

    </div>
  </ContentSection>
</Layout>
