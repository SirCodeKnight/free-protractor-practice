---
const title = 'Explore wikiHow to measure anything';

const topCategories = [
  { name: 'Geometry Tricks', image: '/images/blog/arch-tricks.png', href: '/blog/5-life-saving-geometry-tricks' },
  { name: 'Digital Tools', image: '/images/blog/digital-vs-plastic.png', href: '/blog/digital-protractors-replacing-plastic' },
  { name: 'Engineering', image: '/images/blog/blueprints.png', href: '/blog/measuring-complex-angles-blueprints' },
  { name: 'Printables', image: '/images/blog/printing-protractor.png', href: '/blog/how-to-print-perfect-protractor' }
];

const allCategories = [
  { name: 'Design Ratios', icon: '🎨', href: '/blog/golden-ratio-modern-design' },
  { name: 'Architecture', icon: '🏛️', href: '/blog/5-life-saving-geometry-tricks' },
  { name: 'Hardware vs Software', icon: '💻', href: '/blog/digital-protractors-replacing-plastic' },
  { name: 'Blueprint Reading', icon: '📐', href: '/blog/measuring-complex-angles-blueprints' },
  { name: 'At-Home Printing', icon: '🖨️', href: '/blog/how-to-print-perfect-protractor' },
  { name: 'Angle Mathematics', icon: '🧮', href: '/angle-calculator' }
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style>
    /* Add a clean sans-serif base */
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #fcfcfc; margin: 0; }
  </style>
</head>
<body>

  <!-- WikiHow Style Top Header -->
  <header class="bg-[#9eb96e] text-white py-2 px-4 shadow-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <a href="/blog" class="flex items-center gap-2 no-underline text-white hover:opacity-90">
        <span class="font-bold text-2xl tracking-tight">wiki<span class="font-normal">How</span></span>
        <span class="text-xs uppercase tracking-widest bg-white/20 px-2 py-0.5 rounded">To measure anything...</span>
      </a>
      
      <div class="flex flex-1 w-full max-w-lg relative">
        <input type="text" placeholder="Search wikiHow..." class="w-full py-2 px-4 rounded-full border-none focus:outline-none focus:ring-2 focus:ring-[#85a05b] text-gray-800" />
        <button class="absolute right-2 top-1.5 bg-[#85a05b] hover:bg-[#728a4d] text-white px-3 py-0.5 rounded-full text-sm font-medium transition">Search</button>
      </div>

      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href="#" class="flex flex-col items-center hover:text-white/80 transition"><span class="text-xl">📝</span> Quizzes</a>
        <a href="#" class="flex flex-col items-center hover:text-white/80 transition"><span class="text-xl">🔍</span> Explore</a>
        <a href="#" class="flex flex-col items-center hover:text-white/80 transition"><span class="text-xl">👤</span> Log In</a>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto py-12 px-4 text-center">
    
    <h1 class="text-4xl font-bold text-gray-800 mb-4">Explore wikiHow</h1>
    <p class="text-lg text-gray-600 mb-12 max-w-2xl mx-auto">wikiHow has over 100,000 human-written articles, engaging quizzes, and captivating forums. Find what you are looking for by exploring a category!</p>

    <!-- Top Categories Grid -->
    <div class="text-left mb-16">
      <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-2">Top Categories</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {topCategories.map(cat => (
          <a href={cat.href} class="relative block h-40 rounded-2xl overflow-hidden group shadow-sm hover:shadow-md transition">
            <img src={cat.image} alt={cat.name} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition"></div>
            <div class="absolute inset-0 flex items-center justify-center p-4">
              <h3 class="text-white font-bold text-xl text-center shadow-sm drop-shadow-md">{cat.name}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- All Categories List -->
    <div class="text-left mb-16">
      <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b border-gray-200 pb-2">All Categories</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allCategories.map(cat => (
          <a href={cat.href} class="flex items-center gap-4 p-4 rounded-xl border border-gray-200 hover:border-[#9eb96e] hover:shadow-sm transition bg-white group">
            <div class="w-12 h-12 rounded-lg bg-[#f0f5e5] text-[#9eb96e] flex items-center justify-center text-2xl group-hover:bg-[#9eb96e] group-hover:text-white transition-colors">
              {cat.icon}
            </div>
            <span class="font-semibold text-gray-700 group-hover:text-[#9eb96e] transition-colors">{cat.name}</span>
          </a>
        ))}
      </div>
    </div>

  </main>
</body>
</html>
