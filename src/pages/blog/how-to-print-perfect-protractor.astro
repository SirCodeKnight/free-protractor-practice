---
import Layout from '../../layouts/Layout.astro';
import ContentSection from '../../components/ContentSection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import StudyNote from '../../components/StudyNote.astro';

const title = "How to Print a Perfectly Accurate Protractor at Home";
const description = "Printer scaling issues ruining your measurements? Learn the exact settings to print a mathematically perfect protractor.";
const image = "/images/blog/printing-protractor.png";

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  image: `https://webprotractor.netlify.app${image}`,
  description: description,
  author: {
    '@type': 'Organization',
    name: 'Online Geometry Tools'
  }
};
---
<Layout title={title} description={description} schemas={[articleSchema]}>
  <ContentSection>
    <div class="w-full flex justify-center mb-8">
      <Breadcrumbs items={[
        { name: 'Blog', url: '/blog' },
        { name: 'Printing Protractors', url: '/blog/how-to-print-perfect-protractor' }
      ]} />
    </div>

    <article class="max-w-[900px] mx-auto">
      <header class="text-center mb-12">
        <div class="flex items-center justify-center gap-3 mb-6">
          <span class="caption-mono text-[var(--color-link)] uppercase tracking-wider text-sm">Resource Notes</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-hairline-strong)]"></span>
          <span class="caption text-[var(--color-mute)]">Study Guide • Chapter 4</span>
        </div>
      </header>
      
      <StudyNote>
        <span class="study-sticker" style="top: -20px; left: 15px;">🖨️</span>
        
        <h1 style="margin-top: 0;">How to Print a <span class="study-highlight">Perfect Protractor</span></h1>
        <p>You printed a free protractor, and your homework is completely wrong. What happened? <span class="study-underline">Your printer scaled it.</span></p>

        <div class="study-box" style="transform: rotate(1deg);">
          <span class="study-sticker" style="top: -20px; right: -15px;">⚠️</span>
          <h3>The Golden Rule: Do Not Scale</h3>
          <p>Printers try to force images into "safe margins". You must disable this.</p>
          <ul>
            <li>❌ <strong>Bad:</strong> "Fit to Page"</li>
            <li>✅ <strong>Good:</strong> <span class="study-highlight">"Actual Size" or "100% Scale"</span></li>
          </ul>
        </div>

        <h2>File Type Matters 📄</h2>
        <p>Never print a JPG! Raster images distort. Always print mathematically perfect Vectors (like SVG or PDF).</p>

        <div class="flex justify-center my-6">
          <svg width="40" height="24" viewBox="0 0 40 24" fill="none" stroke="#e74c3c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h30M25 5l10 7-10 7"/>
          </svg>
        </div>

        <h2>Paper Quality Hack</h2>
        <p>Standard 20lb paper bends and warps when measuring.</p>
        <ul>
          <li>Use <strong>Cardstock (65lb - 110lb)</strong>.</li>
          <li>Or, use a glue stick to paste it onto cardboard before cutting!</li>
          <li><span class="study-highlight">Pro-Hack:</span> Print on transparency film so you can see through it like real plastic!</li>
        </ul>

      </StudyNote>
    </article>
  </ContentSection>
  <RelatedTools currentPath="/blog/how-to-print-perfect-protractor" />
</Layout>
