---
import Layout from '../../layouts/Layout.astro';
import ContentSection from '../../components/ContentSection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import StudyNote from '../../components/StudyNote.astro';

const title = "The Hidden Math: Unlocking the Golden Ratio in Modern Design";
const description = "Why do certain websites look inherently beautiful? The answer lies in a 2,000-year-old mathematical sequence.";
const image = "/images/blog/golden-ratio.png";

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  image: `https://webprotractor.netlify.app${image}`,
  description: description,
  author: {
    '@type': 'Organization',
    name: 'Online Geometry Tools'
  }
};
---
<Layout title={title} description={description} schemas={[articleSchema]}>
  <ContentSection>
    <div class="w-full flex justify-center mb-8">
      <Breadcrumbs items={[
        { name: 'Blog', url: '/blog' },
        { name: 'Golden Ratio', url: '/blog/golden-ratio-modern-design' }
      ]} />
    </div>

    <article class="max-w-[900px] mx-auto">
      <header class="text-center mb-12">
        <div class="flex items-center justify-center gap-3 mb-6">
          <span class="caption-mono text-[var(--color-link)] uppercase tracking-wider text-sm">Design Notes</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-hairline-strong)]"></span>
          <span class="caption text-[var(--color-mute)]">Study Guide • Chapter 5</span>
        </div>
      </header>
      
      <StudyNote>
        <span class="study-sticker" style="top: -10px; right: 20px;">✨</span>
        
        <h1 style="margin-top: 0;">Unlocking the <span class="study-highlight">Golden Ratio</span></h1>
        <p>Why do Apple product pages look so good? It's not magic, it's <span class="study-underline">Geometry</span>.</p>

        <div class="study-box" style="transform: rotate(-1deg);">
          <span class="study-sticker" style="top: -20px; left: -20px;">🧠</span>
          <h3>The Math: Phi (φ)</h3>
          <p>The Golden Ratio is <span class="study-highlight">1 : 1.618</span>.</p>
          <p>It's found in galaxies, nautilus shells, and... UI Design!</p>
        </div>

        <h2>1. Typographic Hierarchy</h2>
        <p>Don't guess font sizes. Use math!</p>
        
        <div class="study-code">
          // The perfect font scale:
          let bodyText = 16;
          let h2Text = bodyText * 1.618; // ~26px
          let h1Text = h2Text * 1.618;   // ~42px
        </div>

        <div class="flex justify-center my-6">
          <svg width="24" height="40" viewBox="0 0 24 40" fill="none" stroke="#f5a623" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5v30M5 25l7 10 7-10"/>
          </svg>
        </div>

        <h2>2. Layout Grids</h2>
        <p>Divide a 1920px screen by 1.618.</p>
        <ul>
          <li><strong>Main Content:</strong> 1187px</li>
          <li><strong>Sidebar:</strong> The leftover space!</li>
        </ul>
        <p>This creates a perfectly balanced <span class="study-highlight">Golden Rectangle</span> on the screen.</p>
        
        <p class="mt-8 text-center font-bold">Use our <a href="/ruler" class="text-blue-600 underline">Digital Ruler</a> to audit your UI columns today!</p>

      </StudyNote>
    </article>
  </ContentSection>
  <RelatedTools currentPath="/blog/golden-ratio-modern-design" />
</Layout>
