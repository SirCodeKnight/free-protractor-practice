---
import Layout from '../layouts/Layout.astro';
import ContentSection from '../components/ContentSection.astro';

const title = "Online Ruler - Measure Inches and Centimeters";
const description = "Free online digital ruler. Measure objects accurately on your screen in inches (in), centimeters (cm), and millimeters (mm).";
---
<Layout title={title} description={description}>
  <ContentSection>
    <div class="max-w-3xl mx-auto text-center" style="margin-bottom: var(--spacing-xl);">
      <p class="caption-mono text-[var(--color-mute)]" style="margin-bottom: var(--spacing-xs);">COMING SOON</p>
      <h1 class="display-lg text-[var(--color-ink)]">Online Digital Ruler</h1>
      <p class="body-lg text-[var(--color-body)] mt-4">
        Our online screen ruler is currently in development. Soon you will be able to calibrate your screen to accurately measure physical objects in inches and centimeters directly on your device.
      </p>
      <a href="/" class="btn-primary mt-8 inline-block no-underline">Return to Protractor</a>
    </div>
  </ContentSection>
</Layout>
