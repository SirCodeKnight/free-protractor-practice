---
import Layout from '../layouts/Layout.astro';
import ContentSection from '../components/ContentSection.astro';

const title = "Online Digital Compass - Find Your Direction";
const description = "Free online compass tool. Find North, South, East, and West using your device's magnetometer and GPS sensors.";
---
<Layout title={title} description={description}>
  <ContentSection>
    <div class="max-w-3xl mx-auto text-center" style="margin-bottom: var(--spacing-xl);">
      <p class="caption-mono text-[var(--color-mute)]" style="margin-bottom: var(--spacing-xs);">COMING SOON</p>
      <h1 class="display-lg text-[var(--color-ink)]">Online Digital Compass</h1>
      <p class="body-lg text-[var(--color-body)] mt-4">
        We are building a highly accurate digital compass that utilizes your phone's magnetometer to help you find your bearings directly in the browser.
      </p>
      <a href="/" class="btn-primary mt-8 inline-block no-underline">Return to Protractor</a>
    </div>
  </ContentSection>
</Layout>
