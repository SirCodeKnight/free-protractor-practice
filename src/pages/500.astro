---
import Layout from '../layouts/Layout.astro';
---

<Layout title="500 – Server Error | WebProtractor" description="Something went wrong on our end." noindex={true}>
  <section class="flex flex-col items-center justify-center text-center" style="min-height: 60vh; padding: var(--spacing-4xl) var(--spacing-lg);">
    <div class="flex flex-col items-center" style="gap: var(--spacing-lg); max-width: 480px;">
      <span class="text-[var(--color-hairline)]" style="font-family: var(--font-sans); font-size: 120px; font-weight: 600; line-height: 1; letter-spacing: -6px;">
        500
      </span>
      <h1 class="display-lg text-[var(--color-ink)]">Something went wrong.</h1>
      <p class="body-lg text-[var(--color-body)]">
        We're experiencing technical difficulties. Please try refreshing the page, or come back in a few minutes.
      </p>
      <div class="flex flex-wrap items-center justify-center" style="gap: var(--spacing-sm);">
        <button onclick="window.location.reload()" class="btn-primary">Try Again</button>
        <a href="/" class="btn-secondary no-underline">Go Home</a>
      </div>
    </div>
  </section>
</Layout>
