---
import Layout from '../layouts/Layout.astro';
import ContentSection from '../components/ContentSection.astro';

const title = 'Contact Us – Online Protractor Tool';
const description = 'Get in touch with the Online Protractor Tool team. Send us feedback, report bugs, or ask questions.';
---

<Layout title={title} description={description}>
  <ContentSection variant="light">
    <div class="mx-auto" style="max-width: 560px;">
      <div class="text-center" style="margin-bottom: var(--spacing-xl);">
        <p class="caption-mono text-[var(--color-mute)]" style="margin-bottom: var(--spacing-xs);">GET IN TOUCH</p>
        <h1 class="display-xl text-[var(--color-ink)]">Contact us.</h1>
        <p class="body-lg text-[var(--color-body)]" style="margin-top: var(--spacing-sm);">
          Have feedback, a bug report, or a question? We'd love to hear from you.
        </p>
      </div>

      <form
        action="https://formspree.io/f/YOUR_FORM_ID"
        method="POST"
        class="flex flex-col bg-[var(--color-canvas)] elevation-3"
        style="gap: var(--spacing-md); border-radius: var(--radius-lg); padding: var(--spacing-xl);"
        id="contact-form"
      >
        <div class="flex flex-col" style="gap: var(--spacing-xxs);">
          <label for="contact-name" class="body-sm-strong text-[var(--color-ink)]">Name</label>
          <input
            type="text"
            id="contact-name"
            name="name"
            required
            placeholder="Your name"
            class="body-sm text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] transition-colors focus:border-[var(--color-link)]"
            style="height: 40px; border-radius: var(--radius-sm); padding: 0 var(--spacing-sm);"
          />
        </div>

        <div class="flex flex-col" style="gap: var(--spacing-xxs);">
          <label for="contact-email" class="body-sm-strong text-[var(--color-ink)]">Email</label>
          <input
            type="email"
            id="contact-email"
            name="email"
            required
            placeholder="you@example.com"
            class="body-sm text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] transition-colors focus:border-[var(--color-link)]"
            style="height: 40px; border-radius: var(--radius-sm); padding: 0 var(--spacing-sm);"
          />
        </div>

        <div class="flex flex-col" style="gap: var(--spacing-xxs);">
          <label for="contact-subject" class="body-sm-strong text-[var(--color-ink)]">Subject</label>
          <select
            id="contact-subject"
            name="subject"
            required
            class="body-sm text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] transition-colors focus:border-[var(--color-link)] cursor-pointer"
            style="height: 40px; border-radius: var(--radius-sm); padding: 0 var(--spacing-sm);"
          >
            <option value="">Select a subject</option>
            <option value="feedback">Feedback</option>
            <option value="bug">Bug Report</option>
            <option value="feature">Feature Request</option>
            <option value="question">General Question</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="flex flex-col" style="gap: var(--spacing-xxs);">
          <label for="contact-message" class="body-sm-strong text-[var(--color-ink)]">Message</label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="5"
            placeholder="Tell us what's on your mind..."
            class="body-sm text-[var(--color-ink)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] transition-colors focus:border-[var(--color-link)] resize-y"
            style="border-radius: var(--radius-sm); padding: var(--spacing-sm);"
          ></textarea>
        </div>

        <button type="submit" class="btn-primary w-full">
          Send Message
        </button>

        <p class="caption text-[var(--color-mute)] text-center">
          We typically respond within 1–2 business days.
        </p>
      </form>
    </div>
  </ContentSection>
</Layout>
