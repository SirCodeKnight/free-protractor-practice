---
import Layout from '../layouts/Layout.astro';
import ContentSection from '../components/ContentSection.astro';

const title = "Angle Calculator - Add, Subtract & Find Angles";
const description = "Free online angle calculator. Calculate complementary, supplementary, and vertical angles instantly.";
---
<Layout title={title} description={description}>
  <ContentSection>
    <div class="max-w-3xl mx-auto text-center" style="margin-bottom: var(--spacing-xl);">
      <p class="caption-mono text-[var(--color-mute)]" style="margin-bottom: var(--spacing-xs);">COMING SOON</p>
      <h1 class="display-lg text-[var(--color-ink)]">Angle Calculator</h1>
      <p class="body-lg text-[var(--color-body)] mt-4">
        We are currently building a comprehensive angle calculator to help you find complementary, supplementary, vertical, and missing angles in triangles and polygons.
      </p>
      <a href="/" class="btn-primary mt-8 inline-block no-underline">Return to Protractor</a>
    </div>
  </ContentSection>
</Layout>
