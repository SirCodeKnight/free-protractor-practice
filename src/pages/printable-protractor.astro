---
import Layout from '../layouts/Layout.astro';
import ContentSection from '../components/ContentSection.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedTools from '../components/RelatedTools.astro';
import StandardProtractor from '../components/protractors/StandardProtractor.astro';

const title = "Printable Protractor - Free High-Res PDF & Image";
const description = "Download and print a free high-resolution 180-degree protractor. Perfect for students, teachers, and math practice. Standard actual size.";

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Printable Protractor',
  url: 'https://webprotractor.netlify.app/printable-protractor',
  description: description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WebProtractor',
  url: 'https://webprotractor.netlify.app'
};
---
<Layout title={title} description={description} schemas={[webAppSchema, websiteSchema]}>
  <ContentSection>
    <div class="w-full flex justify-center">
      <Breadcrumbs items={[{ name: 'Printable Protractor', url: '/printable-protractor' }]} />
    </div>
    <div class="max-w-[768px] w-full mx-auto text-center" style="margin-bottom: var(--spacing-xl);">
      <p class="caption-mono text-[var(--color-mute)]" style="margin-bottom: var(--spacing-xs);">FREE PRINTABLE TOOL</p>
      <h1 class="display-lg text-[var(--color-ink)]">Printable Protractor</h1>
      <p class="body-lg text-[var(--color-body)] mt-4">
        Need a physical protractor? Print this page at 100% scale (no margins) to get an accurate, high-resolution paper protractor for math practice and geometry.
      </p>
    </div>

    <!-- Printable Area -->
    <div class="flex justify-center my-12 print:my-0">
      <!-- Forced white background and black text to ensure perfect printing and avoid dark-mode inversion -->
      <div class="w-[600px] max-w-full p-8 rounded-xl shadow-sm print:shadow-none print:p-0 border border-[var(--color-hairline)] print:border-none" style="background-color: #ffffff; color: #000000;">
        <StandardProtractor width="100%" />
      </div>
    </div>

    <div class="text-center print:hidden flex flex-col items-center gap-4">
      <button onclick="window.print()" class="btn-primary flex items-center gap-2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9V2h12v7" />
          <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" />
          <path d="M6 14h12v8H6z" />
        </svg>
        Print Protractor
      </button>
      <p class="body-sm text-[var(--color-mute)]">
        Tip: Set your printer scaling to "Default" or "100%" to ensure accurate measurements.
      </p>
    </div>
  </ContentSection>
  
  <ContentSection variant="light" class="print:hidden">
    <div class="max-w-[768px] w-full mx-auto">
      <h2 class="display-md text-[var(--color-ink)] mb-6">How to use a printable protractor</h2>
      <div class="body-md text-[var(--color-body)] flex flex-col gap-4">
        <p>A printable protractor works exactly like a physical plastic or metal one. It is a fantastic free resource for students learning geometry, teachers preparing classroom materials, or anyone who needs to measure an angle in a pinch.</p>
        <ol class="list-decimal pl-6 flex flex-col gap-2">
          <li><strong>Print accurately:</strong> Click the print button above. In your print dialog settings, ensure that "Scale" is set to 100% or "Actual Size". Do not use "Fit to Page" as this will distort the size of the protractor.</li>
          <li><strong>Cut it out:</strong> For best results, print on thicker paper or cardstock. Carefully cut along the straight bottom edge and the curved top edge.</li>
          <li><strong>Place the vertex:</strong> Place the center mark (the small circle at the bottom straight edge) exactly over the vertex (the point) of the angle you want to measure.</li>
          <li><strong>Align the baseline:</strong> Rotate the protractor so that the zero-degree line aligns perfectly with one of the lines forming the angle.</li>
          <li><strong>Read the angle:</strong> Follow the other line of the angle to where it intersects the curved edge of the protractor. Read the number to get your measurement. Use the outer numbers if your angle opens to the right, and the inner numbers if it opens to the left.</li>
        </ol>
      </div>
    </div>
  </ContentSection>
  <RelatedTools currentPath="/printable-protractor" />
</Layout>
