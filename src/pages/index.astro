---
import Layout from '../layouts/Layout.astro';
import ContentSection from '../components/ContentSection.astro';
import FAQ from '../components/FAQ.astro';

const title = 'Free Geometry Tools – Online Protractor, Ruler, Angle Calculator';
const description = 'A suite of free online geometry tools including a digital protractor, angle calculator, printable protractor PDFs, and an on-screen ruler.';

const faqItems = [
  {
    question: 'Are all these tools free?',
    answer: 'Yes! Our entire suite of geometry tools is completely free to use. There are no downloads, sign-ups, or subscriptions required.',
  },
  {
    question: 'Do the tools work on mobile devices?',
    answer: 'Absolutely. The online protractor, compass, and calculators are fully responsive and designed to work perfectly on smartphones, tablets, and desktop computers.',
  },
  {
    question: 'Can I print the protractor?',
    answer: 'Yes, we offer a dedicated Printable Protractor tool that allows you to download or print a perfectly scaled, high-resolution 180° protractor.',
  },
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Online Geometry Tools',
  url: 'https://webprotractor.netlify.app'
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Online Protractor Tool',
  url: 'https://webprotractor.netlify.app',
  logo: 'https://webprotractor.netlify.app/favicon.svg',
  description: 'Free online angle measurement tools for education, engineering, construction, and DIY projects.',
};

const tools = [
  { name: 'Online Protractor', url: '/online-protractor', desc: 'Measure angles using your screen, phone gyroscope, or camera.' },
  { name: 'Printable Protractor', url: '/printable-protractor', desc: 'Download a perfectly scaled 180° PDF protractor for printing.' },
  { name: 'Angle Calculator', url: '/angle-calculator', desc: 'Calculate complementary, supplementary, and vertical angles instantly.' },
  { name: 'Online Ruler', url: '/ruler', desc: 'Measure objects on your screen with a perfectly calibrated digital ruler.' },
  { name: 'Compass Tool', url: '/compass', desc: 'Use your phone\'s magnetometer to find North directly in your browser.' },
  { name: 'Geometry Calculator', url: '/geometry-calculator', desc: 'Calculate area and perimeter for circles, rectangles, and triangles.' },
];
---

<Layout title={title} description={description} schemas={[websiteSchema, orgSchema]}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-[var(--color-canvas)]" style="padding: var(--spacing-4xl) var(--spacing-lg);">
    <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 20% 50%, #007cf0 0%, transparent 50%),
             radial-gradient(ellipse at 80% 20%, #7928ca 0%, transparent 50%);"
    ></div>

    <div class="relative mx-auto text-center flex flex-col items-center" style="max-width: 800px; gap: var(--spacing-lg);">
      <div class="inline-flex items-center caption-mono text-[var(--color-body)] bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]"
        style="padding: var(--spacing-xxs) var(--spacing-sm); border-radius: var(--radius-full); gap: var(--spacing-xs);">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-cyan-deep)]"></span>
        FREE ONLINE TOOLKIT
      </div>

      <h1 class="display-xl text-[var(--color-ink)]" style="max-width: 700px;">
        The Ultimate Collection of Free Geometry Tools.
      </h1>

      <p class="body-lg text-[var(--color-body)]" style="max-width: 560px;">
        Measure, calculate, and explore angles and shapes right in your browser. No downloads or sign-ups required.
      </p>
    </div>
  </section>

  <!-- Tools Directory -->
  <ContentSection variant="soft">
    <div class="max-w-[1000px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map(tool => (
        <a href={tool.url} class="card-base elevation-1 hover:elevation-3 transition-all p-8 flex flex-col bg-[var(--color-canvas)] no-underline border border-[var(--color-hairline)] hover:border-[var(--color-link)] group">
          <h2 class="display-sm text-[var(--color-ink)] group-hover:text-[var(--color-link)] mb-2 transition-colors">{tool.name}</h2>
          <p class="body-md text-[var(--color-body)] leading-relaxed">{tool.desc}</p>
        </a>
      ))}
    </div>
  </ContentSection>

  <!-- FAQ Section -->
  <ContentSection variant="light" id="faq">
    <div class="mx-auto" style="max-width: 720px;">
      <div class="text-center" style="margin-bottom: var(--spacing-xl);">
        <p class="caption-mono text-[var(--color-mute)]" style="margin-bottom: var(--spacing-xs);">FAQ</p>
        <h2 class="display-lg text-[var(--color-ink)]">Common questions.</h2>
      </div>
      <FAQ items={faqItems} />
    </div>
  </ContentSection>
</Layout>
