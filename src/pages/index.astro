---
import Layout from '../layouts/Layout.astro';
import ContentSection from '../components/ContentSection.astro';
import FAQ from '../components/FAQ.astro';

const title = 'Free Geometry Tools – Online Protractor, Ruler, Angle Calculator | WebProtractor';
const description = 'A suite of free online geometry tools including a digital protractor, angle calculator, printable protractor PDFs, and an on-screen ruler.';

const faqItems = [
  {
    question: 'Are all these tools free?',
    answer: 'Yes! Our entire suite of geometry tools is completely free to use. There are no downloads, sign-ups, or subscriptions required.',
  },
  {
    question: 'Do the tools work on mobile devices?',
    answer: 'Absolutely. The online protractor, compass, and calculators are fully responsive and designed to work perfectly on smartphones, tablets, and desktop computers.',
  },
  {
    question: 'Can I print the protractor?',
    answer: 'Yes, we offer a dedicated Printable Protractor tool that allows you to download or print a perfectly scaled, high-resolution 180° protractor.',
  },
];

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WebProtractor',
  alternateName: ['Web Protractor', 'Online Protractor Tool', 'Free Geometry Tools'],
  url: 'https://webprotractor.netlify.app'
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'WebProtractor',
  url: 'https://webprotractor.netlify.app',
  logo: 'https://webprotractor.netlify.app/favicon.svg',
  description: 'Free online angle measurement tools for education, engineering, construction, and DIY projects.',
};

const tools = [
  { name: 'Online Protractor', url: '/online-protractor', desc: 'Measure angles using your screen, phone gyroscope, or camera.' },
  { name: 'Angle Calculator', url: '/angle-calculator', desc: 'Calculate complementary, supplementary, and vertical angles instantly.' },
  { name: 'Online Ruler', url: '/ruler', desc: 'Measure objects on your screen with a perfectly calibrated digital ruler.' },
  { name: 'Compass Tool', url: '/compass', desc: 'Use your phone\'s magnetometer to find North directly in your browser.' },
  { name: 'Geometry Calculator', url: '/geometry-calculator', desc: 'Calculate area and perimeter for circles, rectangles, and triangles.' },
];

const guides = [
  { name: 'How to Use a Protractor', url: '/guides/how-to-use-a-protractor', desc: 'A step-by-step guide to measuring and drawing angles.' },
  { name: 'Types of Angles', url: '/guides/types-of-angles', desc: 'Learn the difference between acute, right, obtuse, straight, and reflex angles.' },
  { name: 'View All Guides', url: '/guides', desc: 'Browse our complete library of geometry tutorials.' },
];
---

<Layout title={title} description={description} schemas={[websiteSchema, orgSchema]}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-[var(--color-canvas)]" style="padding: var(--spacing-4xl) var(--spacing-lg);">
    <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 20% 50%, #007cf0 0%, transparent 50%),
             radial-gradient(ellipse at 80% 20%, #7928ca 0%, transparent 50%);"
    ></div>

    <div class="relative mx-auto text-center flex flex-col items-center" style="max-width: 800px; gap: var(--spacing-lg);">
      <div class="inline-flex items-center caption-mono text-[var(--color-body)] bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)]"
        style="padding: var(--spacing-xxs) var(--spacing-sm); border-radius: var(--radius-full); gap: var(--spacing-xs);">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-cyan-deep)]"></span>
        FREE GEOMETRY TOOLKIT
      </div>

      <h1 class="display-xl text-[var(--color-ink)]" style="max-width: 700px;">
        The Ultimate Collection of Free Geometry Tools.
      </h1>

      <p class="body-lg text-[var(--color-body)]" style="max-width: 560px;">
        Measure, calculate, and explore angles right in your browser. Read our guides or download our free printable resources.
      </p>
    </div>
  </section>

  <!-- Web Tools Directory -->
  <ContentSection variant="soft">
    <div class="max-w-[1000px] mx-auto">
      <div class="mb-8">
        <p class="caption-mono text-[var(--color-mute)] mb-2">INTERACTIVE</p>
        <h2 class="display-lg text-[var(--color-ink)]">Web Tools</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map(tool => (
          <a href={tool.url} class="card-base elevation-1 hover:elevation-3 transition-all p-8 flex flex-col bg-[var(--color-canvas)] no-underline border border-[var(--color-hairline)] hover:border-[var(--color-link)] group">
            <h3 class="display-sm text-[var(--color-ink)] group-hover:text-[var(--color-link)] mb-2 transition-colors">{tool.name}</h3>
            <p class="body-md text-[var(--color-body)] leading-relaxed">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </ContentSection>

  <!-- Resources (Printables) -->
  <ContentSection variant="light">
    <div class="max-w-[1000px] mx-auto">
      <div class="mb-8">
        <p class="caption-mono text-[var(--color-mute)] mb-2">RESOURCES</p>
        <h2 class="display-lg text-[var(--color-ink)]">Printable Protractors</h2>
      </div>
      <div class="p-8 md:p-12 bg-[var(--color-canvas)] rounded-2xl border border-[var(--color-hairline)] flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="max-w-[500px]">
          <h3 class="display-sm text-[var(--color-ink)] mb-4">Printable Protractor Library</h3>
          <p class="body-lg text-[var(--color-body)] mb-6">Need a physical protractor? Browse our massive library of free, high-resolution printable PDFs. We have standard 180°, 360° circular, triangle, and ruler variations.</p>
          <a href="/printable-protractors" class="btn-primary inline-block no-underline">Browse Printables</a>
        </div>
        <div class="hidden md:block w-[200px] h-[200px] bg-[var(--color-canvas-soft)] rounded-xl border border-[var(--color-hairline)] flex items-center justify-center relative overflow-hidden">
           <svg viewBox="0 0 400 220" class="w-[150%] absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20" style="color: var(--color-ink);">
            <path d="M 20 200 A 180 180 0 0 1 380 200" fill="none" stroke="currentColor" stroke-width="4"/>
            <line x1="10" y1="200" x2="390" y2="200" stroke="currentColor" stroke-width="4"/>
            <circle cx="200" cy="200" r="10" fill="currentColor"/>
          </svg>
        </div>
      </div>
    </div>
  </ContentSection>

  <!-- Guides Directory -->
  <ContentSection variant="soft">
    <div class="max-w-[1000px] mx-auto">
      <div class="mb-8">
        <p class="caption-mono text-[var(--color-mute)] mb-2">LEARN</p>
        <h2 class="display-lg text-[var(--color-ink)]">Geometry Guides</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {guides.map(guide => (
          <a href={guide.url} class="card-base elevation-1 hover:elevation-3 transition-all p-6 flex flex-col bg-[var(--color-canvas)] no-underline border border-[var(--color-hairline)] hover:border-[var(--color-link)] group">
            <h3 class="display-sm text-[var(--color-ink)] group-hover:text-[var(--color-link)] mb-2 transition-colors">{guide.name}</h3>
            <p class="body-md text-[var(--color-body)] leading-relaxed">{guide.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </ContentSection>

  <!-- FAQ Section -->
  <ContentSection variant="light" id="faq">
    <div class="mx-auto" style="max-width: 720px;">
      <div class="text-center" style="margin-bottom: var(--spacing-xl);">
        <p class="caption-mono text-[var(--color-mute)]" style="margin-bottom: var(--spacing-xs);">FAQ</p>
        <h2 class="display-lg text-[var(--color-ink)]">Common questions.</h2>
      </div>
      <FAQ items={faqItems} />
    </div>
  </ContentSection>
</Layout>
