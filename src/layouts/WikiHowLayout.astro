---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  category?: string;
  author?: string;
  updatedAt?: string;
  views?: string;
}

const { title, category = "GEOMETRY", author = "SirCodeKnight", updatedAt = "Today", views = "10,000+" } = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: `${title} - A practical guide from WebProtractor covering essential geometry concepts and techniques.`,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'WebProtractor',
    logo: {
      '@type': 'ImageObject',
      url: 'https://webprotractor.netlify.app/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://webprotractor.netlify.app${Astro.url.pathname}`,
  },
};
---
<Layout title={title} description={`${title} - A practical guide from WebProtractor covering essential geometry concepts and techniques.`} schemas={[articleSchema]} hideNav={true}>
<div class="bg-white min-h-screen font-sans">
  <!-- WikiHow Style Top Header -->
  <header class="bg-[#9eb96e] text-white py-2 px-4 shadow-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <!-- Logo Area -->
      <a href="/blog" class="flex items-center gap-2 no-underline text-white hover:opacity-90">
        <span class="font-bold text-2xl tracking-tight">wiki<span class="font-normal">How</span></span>
        <span class="text-xs uppercase tracking-widest bg-white/20 px-2 py-0.5 rounded">To do anything...</span>
      </a>
      
      <!-- Search Bar -->
      <div class="hidden md:flex flex-1 max-w-lg mx-8 relative">
        <input type="text" placeholder="Search wikiHow..." class="w-full py-2 px-4 rounded-full border-none focus:outline-none focus:ring-2 focus:ring-[#85a05b] text-gray-800" />
        <button class="absolute right-2 top-1.5 bg-[#85a05b] hover:bg-[#728a4d] text-white px-3 py-0.5 rounded-full text-sm font-medium transition">Search</button>
      </div>

      <!-- Right Nav Icons -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href="/geometry-calculator" class="flex flex-col items-center hover:text-white/80 transition"><span class="text-xl">📐</span> Calculator</a>
        <a href="/online-protractor" class="flex flex-col items-center hover:text-white/80 transition"><span class="text-xl">📏</span> Protractor</a>
        <a href="/ruler" class="flex flex-col items-center hover:text-white/80 transition"><span class="text-xl">📏</span> Ruler</a>
      </nav>
    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="max-w-6xl mx-auto py-8 px-4 grid grid-cols-1 lg:grid-cols-[2.5fr_1fr] gap-8">
    
    <!-- Left Column: The Article -->
    <article class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <!-- Breadcrumbs & Title -->
      <div class="p-6 md:p-10 border-b border-gray-100">
        <p class="text-sm text-gray-500 font-bold uppercase tracking-wide mb-4">
          <a href="/blog" class="hover:underline">Home</a> &raquo; <a href="#" class="hover:underline text-[#9eb96e]">{category}</a>
        </p>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-6 leading-tight">{title}</h1>
        <button class="bg-[#facc15] hover:bg-[#eab308] text-gray-900 font-bold py-3 px-8 rounded-md text-lg transition-colors shadow-sm">
          Start Reading
        </button>
      </div>

      <!-- WikiHow Style Content Container -->
      <div class="p-6 md:p-10 text-gray-800 text-lg leading-relaxed wikihow-content">
        <slot />
      </div>
    </article>

    <!-- Right Column: Sidebar -->
    <aside class="flex flex-col gap-6">
      
      <!-- Co-Author Box -->
      <div class="bg-[#fdf9e6] rounded-lg border border-[#e8dcb3] p-6 shadow-sm">
        <div class="flex items-start gap-4 mb-4">
          <img src="https://ui-avatars.com/api/?name=Sir+CodeKnight&background=9eb96e&color=fff" alt="Author" class="w-16 h-16 rounded-full shadow-sm" />
          <div>
            <p class="text-sm text-gray-600 mb-1">Co-authored by:</p>
            <p class="font-bold text-gray-800 text-lg">{author}</p>
            <p class="text-xs text-[#9eb96e] font-bold">Geometry Expert</p>
          </div>
        </div>
        <div class="border-t border-[#e8dcb3] pt-4 grid grid-cols-2 gap-4 text-sm text-gray-600">
          <div>
            <p><strong>Updated:</strong><br/>{updatedAt}</p>
          </div>
          <div>
            <p><strong>Views:</strong><br/>{views}</p>
          </div>
        </div>
      </div>

      <!-- Related Content List -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="bg-[#4b335c] text-white py-3 px-4 font-bold">
          Related Articles
        </div>
        <ul class="p-0 m-0 list-none">
          <li class="border-b border-gray-100 last:border-0 hover:bg-gray-50 transition">
            <a href="/blog/5-life-saving-geometry-tricks" class="flex items-center p-4 gap-3 no-underline text-gray-700">
              <span class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold">1</span>
              <span class="font-medium text-sm">5 Life-Saving Geometry Tricks</span>
            </a>
          </li>
          <li class="border-b border-gray-100 last:border-0 hover:bg-gray-50 transition">
            <a href="/blog/digital-protractors-replacing-plastic" class="flex items-center p-4 gap-3 no-underline text-gray-700">
              <span class="w-8 h-8 rounded-full bg-green-100 text-green-600 flex items-center justify-center font-bold">2</span>
              <span class="font-medium text-sm">Digital vs Plastic Protractors</span>
            </a>
          </li>
          <li class="border-b border-gray-100 last:border-0 hover:bg-gray-50 transition">
            <a href="/blog/measuring-complex-angles-blueprints" class="flex items-center p-4 gap-3 no-underline text-gray-700">
              <span class="w-8 h-8 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center font-bold">3</span>
              <span class="font-medium text-sm">Measuring Complex Blueprints</span>
            </a>
          </li>
        </ul>
      </div>

    </aside>

  </main>
</div>
</Layout>

<style is:global>
  /* WikiHow Content Styles */
  .wikihow-content h2 {
    font-size: 2rem;
    font-weight: 700;
    color: #333;
    margin-top: 2rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .wikihow-step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background-color: #9eb96e;
    color: white;
    border-radius: 999px;
    font-size: 1.25rem;
  }

  .wikihow-content p {
    margin-bottom: 1.25rem;
  }

  .wikihow-content ul, .wikihow-content ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .wikihow-content li {
    margin-bottom: 0.5rem;
  }

  .wikihow-content strong {
    color: #000;
  }

  .wikihow-image {
    width: 100%;
    border-radius: 1.5rem; /* wikiHow curved borders */
    margin: 1.5rem 0;
    border: 3px solid #e5e7eb;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    background-color: #fcfcfc;
  }
</style>
